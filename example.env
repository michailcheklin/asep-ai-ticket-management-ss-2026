# Erforderliche Rechte, um in Zammad ein Ticket zu erstellen
# (unter Profil -> Token-Zugriff -> Erstellen):
# ticket.agent, ticket.customer, admin (für Admin-Aufgaben)
ZAMMAD_API_TOKEN="<In der Zammad-Instanz erstellter API-Key>"

APP_ENV=local

# --- Incident-zu-Problem-Eskalation (konfigurierbare Schwellenwerte) ---
# Anzahl thematisch gleicher offener Incidents (inkl. dem neuen), ab der ein
# Problem-Ticket automatisch erzeugt wird.
INCIDENT_ESCALATION_MIN_COUNT=5
# Zeitfenster in Stunden, in dem Incidents als "recent" gelten.
INCIDENT_RECENCY_WINDOW_HOURS=8
# Cosine-Similarity-Schwelle für die semantische Ähnlichkeit zweier Incidents.
INCIDENT_SIMILARITY_THRESHOLD=0.55
# Absender-/Kunden-E-Mail für automatisch erzeugte Problem-Tickets
# (fällt auf ZAMMAD_SUPPORT_EMAIL zurück, wenn leer).
PROBLEM_TICKET_AUTHOR_EMAIL=
# Öffentlich erreichbare Zammad-Basis-URL für klickbare Ticket-Links
# (fällt auf ZAMMAD_INTERNAL_URL zurück, wenn leer).
ZAMMAD_PUBLIC_URL=

# Support identity
ZAMMAD_SUPPORT_EMAIL=support@localhost
ZAMMAD_SUPPORT_NAME=Support
ZAMMAD_SUPPORT_GROUP=Users

# Local SMTP via Mailpit
ZAMMAD_SMTP_HOST=mailpit
ZAMMAD_SMTP_PORT=1025
ZAMMAD_SMTP_USER=
ZAMMAD_SMTP_PASSWORD=
ZAMMAD_SMTP_DOMAIN=
# Trigger names
ZAMMAD_CLOSE_TRIGGER_NAME="customer notification (on close)"
ZAMMAD_REOPEN_TRIGGER_NAME="customer notification (on reopen)"
ZAMMAD_REOPEN_MARKER_TAG=customer_notified_closed

SAIA_API_KEY:
USE_SAIA_API=false

# For tracing the application workflow with Langsmith
# For setup instructions cf. backend/graph/README.md
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=(your Langsmith API key)
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com