# Erforderliche Rechte, um in Zammad ein Ticket zu erstellen
# (unter Profil -> Token-Zugriff -> Erstellen):
# ticket.agent, ticket.customer, admin (für Admin-Aufgaben)
ZAMMAD_API_TOKEN="<In der Zammad-Instanz erstellter API-Key>"

APP_ENV=local

# --- Incident-zu-Problem-Eskalation (konfigurierbare Schwellenwerte) ---
# Anzahl thematisch gleicher offener Incidents (inkl. dem neuen), ab der ein
# Problem-Ticket automatisch erzeugt wird.
INCIDENT_ESCALATION_MIN_COUNT=5
# Zeitfenster in Stunden, in dem Incidents als "recent" gelten.
INCIDENT_RECENCY_WINDOW_HOURS=8
# Cosine-Similarity-Schwelle für die semantische Ähnlichkeit zweier Incidents.
INCIDENT_SIMILARITY_THRESHOLD=0.55
# Absender-/Kunden-E-Mail für automatisch erzeugte Problem-Tickets
# (fällt auf ZAMMAD_SUPPORT_EMAIL zurück, wenn leer).
PROBLEM_TICKET_AUTHOR_EMAIL=
# Öffentlich erreichbare Zammad-Basis-URL für klickbare Ticket-Links
# (fällt auf ZAMMAD_INTERNAL_URL zurück, wenn leer).
ZAMMAD_PUBLIC_URL=

# Support identity
ZAMMAD_SUPPORT_EMAIL=support@localhost
ZAMMAD_SUPPORT_NAME=Support
ZAMMAD_SUPPORT_GROUP=Users

# Local SMTP via Mailpit
ZAMMAD_SMTP_HOST=mailpit
ZAMMAD_SMTP_PORT=1025
ZAMMAD_SMTP_USER=
ZAMMAD_SMTP_PASSWORD=
ZAMMAD_SMTP_DOMAIN=

# --- Email ticket transmission (first public support article → external recipient) ---
# Disabled by default. When enabled, EMAIL_TICKET_TRANSMISSION_RECIPIENT is required.
EMAIL_TICKET_TRANSMISSION_ENABLED=false
# Placeholder only — set the real address in deployment configuration, never commit it.
EMAIL_TICKET_TRANSMISSION_RECIPIENT=recipient@example.com
# Shared secret for POST /webhook/article-created (header X-Webhook-Secret or HTTP Basic).
EMAIL_TICKET_TRANSMISSION_WEBHOOK_SECRET=
# Optional SQLite path for persistent transmission records (duplicate protection).
# EMAIL_TICKET_TRANSMISSION_DB_PATH=
# Optional SMTP overrides for backend sending (defaults reuse ZAMMAD_SMTP_* / support email).
# EMAIL_SMTP_HOST=mailpit
# EMAIL_SMTP_PORT=1025
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_FROM=
# EMAIL_SMTP_USE_TLS=false
# Trigger names
ZAMMAD_CLOSE_TRIGGER_NAME="customer notification (on close)"
ZAMMAD_REOPEN_TRIGGER_NAME="customer notification (on reopen)"
ZAMMAD_REOPEN_MARKER_TAG=customer_notified_closed

SAIA_API_KEY:
USE_SAIA_API=false
# Ollama endpoint for the local LLM fallback. Defaults to http://localhost:11434;
# set to http://ollama:11434 when using zammad/scenarios/add-ollama.yml
# (in-stack service hostname).
OLLAMA_BASE_URL=

# Selects which backend/llm/AGENTS/<name>.md file defines the shared agent behavior
AGENT=ZIM

# --- Speech-to-text (faster-whisper, POST /transcribe) ---
# CPU-only by default: no GPU passthrough is configured anywhere in this
# project's docker-compose setup.
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# For tracing the application workflow with Langsmith
# For setup instructions cf. backend/graph/README.md
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=(your Langsmith API key)
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com